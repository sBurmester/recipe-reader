HTTP_ADDR=127.0.0.1:8080
API_TOKEN=
CORS_ORIGINS=http://localhost:5173

# Must match the POSTGRES_PASSWORD you start compose with (`POSTGRES_PASSWORD=dev make db-up`).
# Compose has no default password any more: it was the guessable recipes/recipes/recipes.
DB_DSN=postgres://recipes:dev@localhost:5432/recipes?sslmode=disable
POSTGRES_PASSWORD=dev
# The DSN the app container uses under docker compose. Empty means compose builds it from
# POSTGRES_* against the db service; DB_DSN above is for a binary running on the host.
CONTAINER_DB_DSN=

INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_PATH=data/instagram-session.json
INSTAGRAM_COLLECTION=Rezepte

EXTRACTION_MODE=hybrid
EXTRACTION_CONFIDENCE_THRESHOLD=0.6
EXTRACTION_PUBLISH_THRESHOLD=0.8

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

IMPORT_INTERVAL=6h

LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=60s

IMPORT_MAX_ITEMS=50
IMPORT_MAX_PAGES=100

# Applies to every command. Levels: debug, info, warn, error. Formats: text, json.
LOG_LEVEL=info
LOG_FORMAT=text
