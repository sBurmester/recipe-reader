HTTP_ADDR=:8080

DB_DSN=postgres://recipes:recipes@localhost:5432/recipes?sslmode=disable

INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_PATH=data/instagram-session.json
INSTAGRAM_COLLECTION=Rezepte

EXTRACTION_MODE=hybrid
EXTRACTION_CONFIDENCE_THRESHOLD=0.6

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

IMPORT_INTERVAL=6h

# LLM extractor provider (Task 25). anthropic (default) = Anthropic Messages API.
# openai = any OpenAI-compatible /chat/completions endpoint; set LLM_BASE_URL to
# target Groq, Together, OpenRouter, Ollama (/v1), vLLM, or LM Studio.
# When LLM_PROVIDER=anthropic, LLM_API_KEY / LLM_MODEL fall back to
# ANTHROPIC_API_KEY / ANTHROPIC_MODEL above.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
